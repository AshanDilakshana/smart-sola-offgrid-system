# Server Port
PORT=5000

# MongoDB Connection URI (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.4lkspya.mongodb.net/smart_offgrid_db?retryWrites=true&w=majority

# AWS IoT Core Endpoint (From AWS Console -> IoT Core -> Settings -> Device data endpoint)
# Example: a1b2c3d4e5f6g7-ats.iot.ap-southeast-1.amazonaws.com
AWS_IOT_ENDPOINT=a1ftomq193a3f9-ats.iot.us-east-1.amazonaws.com

# AWS IoT Core Certificate Paths
MQTT_CA_PATH=./certs/AmazonRootCA1.pem
MQTT_CERT_PATH=./certs/403442dcb14e0a38ef4fc1b65681a0dff9775afdd14f900e2d1cea114d3fefa1-certificate.pem.crt
MQTT_KEY_PATH=./certs/403442dcb14e0a38ef4fc1b65681a0dff9775afdd14f900e2d1cea114d3fefa1-private.pem.key

# Fallback MQTT Broker URL (Used if AWS_IOT_ENDPOINT is empty)
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=ashan_smart_offgrid_v1
HISTORY_LOG_INTERVAL_MINUTES=15
